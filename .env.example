# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- LLM (proveedor configurable) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Provisional: se confirman contra la documentación vigente de OpenAI
MODEL_SMALL=gpt-4o-mini
MODEL_MAIN=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- ERP ---
# dynamics | sap
ERP_ADAPTER=dynamics
# Token de solo lectura: lo usa el agente
ERP_READ_TOKEN=
# Token de escritura: lo usa únicamente el servicio de ejecución
ERP_WRITE_TOKEN=
# Token de administración: solo para los endpoints de la demo (cambiar stock, reiniciar datos)
ERP_ADMIN_TOKEN=

# --- Identidad ---
JWT_SECRET=

# --- Observabilidad (Langfuse Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Límites del agente ---
MAX_AGENT_ITERATIONS=8
MAX_TOKENS_PER_REQUEST=4000
LLM_TIMEOUT_SECONDS=30
