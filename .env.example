# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- LLM (proveedor configurable) ---
# openai | azure_openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Solo si LLM_PROVIDER=azure_openai (los deployments deben llamarse como el modelo)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# Máximo de tokens de salida por llamada
LLM_MAX_OUTPUT_TOKENS=800
# Verificados con llamada real (temperatura 0 + salida estructurada). Ver docs/decisiones.md
MODEL_SMALL=gpt-5.6-luna
MODEL_MAIN=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
CHROMA_PATH=/data/chroma
POLICIES_DIR=/policies
# Calibrado con 11 consultas reales (ver docs/decisiones.md). Es solo la primera capa:
# la segunda es la verificación de respuesta con MODEL_SMALL
RAG_MIN_SCORE=0.40

# --- ERP ---
# dynamics | sap
ERP_ADAPTER=dynamics
ERP_BASE_URL=http://mock-erp:8001
ERP_TIMEOUT_SECONDS=10
# Token de solo lectura: lo usa el agente
ERP_READ_TOKEN=
# Token de escritura: lo usa únicamente el servicio de ejecución
ERP_WRITE_TOKEN=
# Token de administración: solo para los endpoints de la demo (cambiar stock, reiniciar datos)
ERP_ADMIN_TOKEN=

# --- Identidad ---
JWT_SECRET=

# --- Observabilidad (Langfuse Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Límites del agente ---
# Pasos máximos del grafo por turno (la ruta más larga usa 8)
MAX_AGENT_ITERATIONS=12
# Medido: la consulta compleja usa ~5.500 tokens; el límite deja el doble de margen (≈ USD 0,05 en el peor caso)
MAX_TOKENS_PER_REQUEST=12000
LLM_TIMEOUT_SECONDS=30
